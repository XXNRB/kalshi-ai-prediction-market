# --- Backend (backend/.env) ---

# SQLite by default; swap for a Postgres URL in production
# e.g. postgresql+psycopg2://user:password@host:5432/kalshi
DATABASE_URL=sqlite:///./kalshi.db

# Kalshi's public market-data endpoints require no auth for Phase 1 (read-only).
KALSHI_API_BASE=https://api.elections.kalshi.com/trade-api/v2

# Required for Agent 1 (Research Analyst). Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=

OPENAI_MODEL=gpt-4o-mini

# How often the ingestion service polls Kalshi for market updates
INGESTION_INTERVAL_SECONDS=60
INGESTION_MARKET_LIMIT=50

# Frontend origin allowed to call this API
CORS_ORIGINS=["http://localhost:3000"]

# --- Frontend (frontend/.env.local) ---

NEXT_PUBLIC_API_URL=http://localhost:8000
